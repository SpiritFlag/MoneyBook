# Copy this file to .env.local and enter values there.
# Clerk authentication and Neon persistence are active.
# Use development Clerk keys for localhost, production keys on Vercel.
# Use the existing universe Clerk application, with matching instance keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon project: sparkling-pond-46696613 (MoneyBook).
# Apply migrations/001_books.sql with npm run db:migrate before first use.
# Server-only pooled PostgreSQL connection string; never use NEXT_PUBLIC_.
DATABASE_URL=

# Read-only remote MCP: /mcp. Use the SpiritFlag Universe ChatGPT CIMD client.
# ChatGPT connector Client ID and Client Secret fields can remain blank (CIMD).
# Allow profile on this CIMD client in the same Clerk instance used by the app.
# Tokens must include this exact resource in aud and grant the profile scope.
# No shared secret/session-cookie authentication or owner impersonation fallback.
MCP_RESOURCE_URL=https://moneybook.spiritflag.work/mcp
CLERK_AUTHORIZATION_SERVER=https://clerk.spiritflag.work
CLERK_OAUTH_CLIENT_ID=https://chatgpt.com/oauth/client.json
